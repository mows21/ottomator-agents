# AI CEO System - Environment Variables

# ============================================
# REQUIRED
# ============================================

# Claude AI (Required for AI CEO)
ANTHROPIC_API_KEY=your_anthropic_api_key_here
# Get from: https://console.anthropic.com/
# Or use: claude auth login

# ============================================
# PAYMENT PROCESSING (Recommended for revenue)
# ============================================

# Stripe - For credit card payments
STRIPE_API_KEY=sk_test_your_stripe_key
STRIPE_PUBLISHABLE_KEY=pk_test_your_publishable_key
# Get from: https://dashboard.stripe.com/apikeys

# Gumroad - For digital product sales
GUMROAD_ACCESS_TOKEN=your_gumroad_token
# Get from: https://app.gumroad.com/settings/advanced#application-form

# ============================================
# DATABASE & CRM (Optional)
# ============================================

# Airtable - For customer data and tracking
AIRTABLE_API_KEY=your_airtable_key
AIRTABLE_BASE_ID=your_base_id
# Get from: https://airtable.com/account

# Supabase - Alternative database
SUPABASE_URL=your_supabase_url
SUPABASE_KEY=your_supabase_key
# Get from: https://supabase.com/dashboard

# ============================================
# COMMUNICATION (Optional)
# ============================================

# Email - For customer communication
SENDGRID_API_KEY=your_sendgrid_key
FROM_EMAIL=noreply@yourdomain.com
# Get from: https://sendgrid.com/

# Slack - For notifications
SLACK_BOT_TOKEN=xoxb-your-slack-token
SLACK_TEAM_ID=your_team_id
# Get from: https://api.slack.com/apps

# ============================================
# EXTERNAL SERVICES (Optional)
# ============================================

# GitHub - For code deployment
GITHUB_TOKEN=ghp_your_github_token
# Get from: https://github.com/settings/tokens

# Brave Search - For web research agent
BRAVE_API_KEY=your_brave_api_key
# Get from: https://brave.com/search/api/

# Firecrawl - For web scraping
FIRECRAWL_API_KEY=your_firecrawl_key
# Get from: https://firecrawl.dev/

# ============================================
# CONFIGURATION (Optional)
# ============================================

# Demo mode - faster cycles for testing
DEMO_MODE=false  # Set to 'true' for 30-second cycles

# Working directory for file operations
WORKING_DIRECTORY=./workspace

# Data directory for AI CEO
DATA_DIR=./ai-ceo-system/data

# ============================================
# NOTES
# ============================================

# 1. Copy this file to .env:
#    cp .env.example .env

# 2. Fill in your actual API keys

# 3. Never commit .env to git (it's in .gitignore)

# 4. Minimum required: ANTHROPIC_API_KEY
#    Everything else is optional but recommended

# 5. For production revenue, set up at least:
#    - ANTHROPIC_API_KEY (required)
#    - STRIPE_API_KEY or GUMROAD_ACCESS_TOKEN (for payments)
#    - SENDGRID_API_KEY (for customer emails)
