{
  "name": "Slack Notification Workflow",
  "nodes": [
    {
      "parameters": {},
      "id": "trigger-node",
      "name": "When clicking 'Test workflow'",
      "type": "n8n-nodes-base.manualTrigger",
      "typeVersion": 1,
      "position": [250, 300]
    },
    {
      "parameters": {
        "resource": "message",
        "operation": "post",
        "channel": "={{slack_channel}}",
        "text": "={{message_text}}",
        "otherOptions": {
          "username": "={{bot_name || 'n8n Bot'}}"
        }
      },
      "id": "slack-node",
      "name": "Send to Slack",
      "type": "n8n-nodes-base.slack",
      "typeVersion": 2,
      "position": [450, 300],
      "credentials": {
        "slackApi": {
          "id": "1",
          "name": "Slack account"
        }
      }
    }
  ],
  "connections": {
    "When clicking 'Test workflow'": {
      "main": [
        [
          {
            "node": "Send to Slack",
            "type": "main",
            "index": 0
          }
        ]
      ]
    }
  },
  "settings": {
    "executionOrder": "v1"
  },
  "metadata": {
    "description": "Post messages to Slack channels",
    "category": "communication",
    "parameters": {
      "slack_channel": {
        "type": "string",
        "required": true,
        "description": "Slack channel name or ID"
      },
      "message_text": {
        "type": "string",
        "required": true,
        "description": "Message content to post"
      },
      "bot_name": {
        "type": "string",
        "required": false,
        "description": "Display name for the bot",
        "default": "n8n Bot"
      }
    },
    "tags": ["slack", "notification", "communication", "messaging"],
    "use_cases": [
      "Send alerts to team",
      "Post status updates",
      "Notify team of events"
    ]
  }
}
